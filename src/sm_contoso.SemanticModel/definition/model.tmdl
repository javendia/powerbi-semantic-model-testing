model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup dim

	annotation PBI_QueryGroupOrder = 1

queryGroup fact

	annotation PBI_QueryGroupOrder = 2

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Date","Product","Store","Sales","Server","Database","Schema","RangeStart","RangeEnd","Orders"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["WebModelingEdit","SLL","DevMode","TMDLView_Desktop","DaxQueryView_Desktop","MCP-PBIModeling"]

annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["OBJECTS_WITH_NO_DESCRIPTION"]}

ref table Customer
ref table Date
ref table Product
ref table Store
ref table Sales
ref table Orders

ref role Manager
ref role User

ref cultureInfo es-ES

